# Copie para .env e preencha. Nao versione o .env.
APP_KEY=            # gere com: echo "base64:$(openssl rand -base64 32)"
MOTOR_TOKEN=        # segredo compartilhado entre Laravel e motor
ANTHROPIC_API_KEY=  # chave da API, usada pelo nó agente
GH_TOKEN=           # token do GitHub para clonar e abrir PR
APP_URL=http://localhost:8080
PORTA_WEB=8080
