# Copie para .env e preencha. Nao versione o .env.
APP_KEY=            # gere com: echo "base64:$(openssl rand -base64 32)"
MOTOR_TOKEN=        # segredo compartilhado entre Laravel e motor
MCP_TOKEN=          # token do servidor MCP, gere com: openssl rand -hex 32
OLLAMA_URL=http://host.docker.internal:11434  # onde o Ollama responde
OLLAMA_MODELO=      # modelo com suporte a ferramentas, ex: qwen2.5-coder:14b
MOTOR_PROVEDOR=ollama  # ollama ou openai (padrao do no agente)
OPENAI_API_KEY=     # so se usar o provedor openai; nunca versione
OPENAI_MODELO=      # nome do modelo da OpenAI
GH_TOKEN=           # token do GitHub para clonar e abrir PR
APP_URL=http://localhost:8080
PORTA_WEB=8080
